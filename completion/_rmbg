#compdef rmbg

# 只补模型名（只有模型名不好记/不好敲）。其余参数、文件、子命令
# 一律交给 zsh 原生补全（_files 兜底）——注册 compdef 后若不显式
# 兜底，原生文件补全会被接管且不会自动回退。

_rmbg_models() {
  local -a models
  models=("${(@f)$(rmbg list 2>/dev/null)}")
  if (( ${#models[@]} )); then
    _describe 'model' models
  fi
}

_rmbg() {
  case $words[$((CURRENT - 1))] in
    -m | --model | --preload-model)
      _rmbg_models
      ;;
    *)
      _files
      ;;
  esac
}

_rmbg "$@"